# ------------------------------------------------------------------
# OpenCart ITALIA - configurazione dell'ambiente Docker
# Copia questo file in docker/.env.docker con "make init"
# ------------------------------------------------------------------

# Porta con cui raggiungi il negozio dal browser
HTTP_PORT=80
HTTP_EXPOSE_PORT=8080

# PHP
PHP_VERSION=8.4
PHP_UNAME=www-data
PHP_UID=33
TZ=Europe/Rome

# Installazione automatica al primo avvio (1 = sì, 0 = installer web manuale)
AUTO_INSTALL=1

# Dati con cui viene creato il negozio
OPENCART_LANGUAGE=it-it
OPENCART_USERNAME=admin
OPENCART_PASSWORD=admin123
OPENCART_ADMIN_EMAIL=admin@example.com
OPENCART_HTTP_SERVER=http://localhost:8080/

# Database
DB_DRIVER=mysqli
DB_HOSTNAME=mysql
DB_USERNAME=opencart
DB_PASSWORD=opencart
DB_DATABASE=opencart
DB_PREFIX=oc_
DB_PORT=3306
DB_EXPOSE_PORT=3307
DB_ROOT_PASSWORD=opencart

# Servizi facoltativi (si avviano con: make up profiles="adminer redis")
ADMINER_EXPOSE_PORT=8081
REDIS_EXPOSE_PORT=6379
MEMCACHED_EXPOSE_PORT=11211
