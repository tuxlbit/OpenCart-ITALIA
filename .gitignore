# Configurazione del singolo negozio (creata dalla procedura di installazione)
/config.php
/admin/config.php

# Contenuti generati durante l'uso: le cartelle restano, con il loro index.html
/system/storage/cache/*
!/system/storage/cache/index.html
/system/storage/logs/*
!/system/storage/logs/index.html
/system/storage/session/*
!/system/storage/session/index.html
/system/storage/download/*
!/system/storage/download/index.html
/system/storage/upload/*
!/system/storage/upload/index.html
/system/storage/backup/*
!/system/storage/backup/index.html
/image/cache/*
!/image/cache/index.html

# Archivio distribuibile prodotto da build.sh
/dist/

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store
